    Enabled = not Enabled
    UpdateButton()
end)

UpdateButton()

-- TÌM ZONE
local function GetZone()
    local EggSystem = Workspace:FindFirstChild("EggSystem")
    if not EggSystem then return nil end

    local Nests = EggSystem:FindFirstChild("Nests")
    if not Nests then return nil end

    return Nests:FindFirstChild("Cosmic")
end

-- TELE BASE
local function TeleBase()
    for Attempt = 1, 3 do
        local Root = WaitRoot()

        if Root and Root.Parent then
            local Success, Error = pcall(function()
                Root.CFrame = CFrame.new(BASE_POSITION)
            end)

            if Success then
                print("[TELE BASE] SUCCESS - TRY", Attempt)
                return true
            else
                warn("[TELE BASE ERROR]", Error)
            end
        end

        task.wait(0.2)
    end

    warn("[TELE BASE] FAILED - CHARACTER NOT READY")
    return false
end

-- QUÉT TRỨNG
local function GetEggs()
    local Zone = GetZone()
    if not Zone then return {} end

    local Results = {}

    for _, Object in ipairs(Zone:GetDescendants()) do
        if Object:IsA("ProximityPrompt")
            and Object.ActionText == "Steal"
            and Object.Enabled then

            local LastTime = processed[Object] or 0

            if os.clock() - LastTime >= EggCooldown then
                local Model = Object:FindFirstAncestorOfClass("Model")

                if Model then
                    table.insert(Results, {
                        Prompt = Object,
                        Model = Model
                    })
                end
            end
        end
    end

    return Results
end

-- TRỨNG GẦN NHẤT
local function GetNearest(Eggs)
    local Root = GetRoot()
    if not Root then return nil end

    local Best = nil
    local BestDistance = math.huge

    for _, Egg in ipairs(Eggs) do
        local Model = Egg.Model

        local Part = Model.PrimaryPart
            or Model:FindFirstChildWhichIsA("BasePart", true)

        if Part and Egg.Prompt.Parent then
            local Distance = (Root.Position - Part.Position).Magnitude

            if Distance < BestDistance then
                BestDistance = Distance
                Best = Egg
            end
        end
    end

    return Best
end

-- NHẶT TRỨNG
local function PickEgg(Egg)
    local Prompt = Egg.Prompt
    local Model = Egg.Model

    if not Prompt.Parent or not Prompt.Enabled then
        return
    end

    local Root = WaitRoot()

    local Part = Model.PrimaryPart
        or Model:FindFirstChildWhichIsA("BasePart", true)

    if not Root or not Part then return end

    processed[Prompt] = os.clock()

    print("[TARGET]", Model.Name)

    local MoveSuccess, MoveError = pcall(function()
        Root.CFrame = Part.CFrame * CFrame.new(0, 0, 3)
    end)

    if not MoveSuccess then
        warn("[MOVE ERROR]", MoveError)
        return
    end

    task.wait(0.15)

    if Prompt.Parent and Prompt.Enabled then
        local Success, Error = pcall(function()
            fireproximityprompt(Prompt)
        end)

        if Success then
            print("[PICK ATTEMPT]", Model.Name)
        else
            warn("[PICK ERROR]", Error)
        end
    end

    TeleBase()

    if not Prompt.Parent or not Prompt.Enabled then
        print("[EGG REMOVED]", Model.Name)
    else
        print("[WAITING RETRY]", Model.Name)
    end
end

-- AUTO FARM LOOP
task.spawn(function()
    print("[COSMIC AUTO FARM] STARTED")

    while not stopped do
        task.wait(ScanDelay)

        if not Enabled or busy then
            continue
        end

        busy = true

        local Success, Error = pcall(function()
            if not GetPlayer() then
                return
            end

            local Eggs = GetEggs()
            local Target = GetNearest(Eggs)

            if Target then
                PickEgg(Target)
            end
        end)

        if not Success then
            warn("[AUTO FARM ERROR]", Error)
        end

        busy = false
    end
end)

-- THEO DÕI RESPAWN
task.spawn(function()
    while not stopped do
        local Player = GetPlayer()

        if Player then
            local Success, Error = pcall(function()
                Player.CharacterAdded:Wait()
            end)

            if Success then
                print("[CHARACTER] RESPAWN DETECTED")
                task.wait(0.8)

                if Enabled then
                    TeleBase()
                end
            elseif Error then
                warn("[RESPAWN ERROR]", Error)
                task.wait(1)
            end
        else
            task.wait(1)
        end
    end
end)

-- DỌN PROMPT CŨ
task.spawn(function()
    while not stopped do
        task.wait(5)

        for Prompt in pairs(processed) do
            if not Prompt.Parent then
                processed[Prompt] = nil
            end
        end
    end
end)
