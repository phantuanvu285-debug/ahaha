-- CHICKEN DETECTION

local function getHatchedFolder()
    local root = workspace:FindFirstChild("EggHatchLive")
    return root and root:FindFirstChild("Hatched")
end

local function passesMoneyFilter(pet)
    if not AutoCollectByMoney then return true end
    if not updateMoneyThreshold() then return false end

    local income = tonumber(pet:GetAttribute("Income"))
    return income ~= nil and income >= MoneyThresholdValue
end

local function findChicken()
    if not AutoCollect then return nil end

    local hatched = getHatchedFolder()
    local hrp = getHRP()
    if not hatched or not hrp then return nil end

    local bestTarget
    local bestDistance = math.huge

    for _,pet in ipairs(hatched:GetChildren()) do
        if pet:IsA("Model") and pet.Name == "HatchedPet" then
            local rarity = pet:GetAttribute("Rarity")
            local petName = pet:GetAttribute("PetName")
            local income = tonumber(pet:GetAttribute("Income"))

            local petRoot = pet:FindFirstChild("HumanoidRootPart")
            local prompt = petRoot and petRoot:FindFirstChild("StealPrompt")

            if rarity and isSelected(CollectRarities,rarity)
                and passesMoneyFilter(pet)
                and petRoot and prompt
                and prompt:IsA("ProximityPrompt") and prompt.Enabled then

                local distance = (hrp.Position-petRoot.Position).Magnitude
                if distance < bestDistance then
                    bestDistance = distance
                    bestTarget = {
                        Pet = pet,
                        PetName = petName or pet.Name,
                        Rarity = rarity,
                        Income = income or 0,
                        Part = petRoot,
                        Prompt = prompt
                    }
                end
            end
        end
    end

    return bestTarget
end

local function hasCollectTarget()
    if not AutoCollect then
        CollectRequested = false
        return false
    end

    if findChicken() then
        CollectRequested = true
        return true
    end
    return false
end

