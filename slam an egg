local function findShard()
    if not AutoCollectShard then return nil end

    local folder = getShardFolder()
    local hrp = getHRP()
    if not folder or not hrp then return nil end

    local nearest
    local nearestDistance = math.huge

    for _,obj in ipairs(folder:GetChildren()) do
        if obj:IsA("BasePart") and obj.Name == "Shard" then
            local distance = (hrp.Position-obj.Position).Magnitude
            if distance < nearestDistance then
                nearestDistance = distance
                nearest = obj
            end
        end
    end

    return nearest
end

local function hasShardTarget()
    return AutoCollectShard and findShard() ~= nil
end

