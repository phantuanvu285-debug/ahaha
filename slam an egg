-- MAIN LOOP
--========================================================

task.spawn(function()
    while Running and Gui.Parent do

        -- PRIORITY 1: CHICKENS
        if AutoCollect and not CollectBusy then
            if findChicken() then CollectRequested = true end
        end

        if AutoCollect and CollectRequested and not CollectBusy then
            collectChicken()
        end

        if AutoCollect and not CollectBusy then
            if findChicken() then
                CollectRequested = true
                task.wait(0.05)
                continue
            else
                CollectRequested = false
            end
        end

        -- PRIORITY 2: SHARDS
        if AutoCollectShard and not ShardBusy and not CollectBusy and not BreakBusy then
            if findShard() then
                collectShard()
                task.wait(0.05)
                continue
            end
        end

        -- PRIORITY 3: TITANIC ZONE11
        if PriorityTitanic and AutoBreak
            and not CollectBusy and not ShardBusy and not BreakBusy
            and not CollectRequested and not hasShardTarget() then

            local titanic = findTitanicEgg()

            if titanic then
                setStatus("TITANIC FOUND - "..titanic.Name)
                print("[Alexandria] TITANIC FOUND:",titanic:GetFullName())

                if not isGauntletsEquipped() then
                    setStatus("Titanic: Equipping Gauntlets")
                    equipGauntlets()
                end

                if isGauntletsEquipped() then
                    if Player:GetAttribute("AutoSmash") ~= true then
                        enableAutoSmash()
                    end

                    if Player:GetAttribute("AutoSmash") == true then
                        breakEgg(titanic,true)
                    end
                end

                task.wait(0.05)
                continue
            else
                local zone11Eggs = getZoneEggFolder("Zone11")

                if not zone11Eggs or #zone11Eggs:GetChildren() == 0 then
                    stageZone("Zone11")
                    task.wait(0.1)
                    continue
                end
            end
        end

        -- PRIORITY 4: EQUIP BEST WHEN IDLE
        if AutoEquipBest and EquipBestPending then
            processEquipBest()
        end

        -- PRIORITY 5: NORMAL AUTO BREAK
        if AutoBreak and not CollectBusy and not BreakBusy
            and not ShardBusy and not CollectRequested
            and not hasShardTarget() then

            if not isGauntletsEquipped() then
                setStatus("Equipping Gauntlets")
                equipGauntlets()
            end

            if hasCollectTarget() or hasShardTarget() then
                task.wait(0.05)
                continue
            end

            if isGauntletsEquipped() then
                if Player:GetAttribute("AutoSmash") ~= true then
                    enableAutoSmash()
                end

                if Player:GetAttribute("AutoSmash") == true then
                    local zoneName = getCurrentZone()

                    if zoneName then
                        local eggsFolder = getZoneEggFolder(zoneName)

                        if not eggsFolder or #eggsFolder:GetChildren() == 0 then
                            stageZone(zoneName)
                        end

                        if hasCollectTarget() or hasShardTarget() then
                            task.wait(0.05)
                            continue
                        end

                        -- KIỂM TRA TITANIC TRƯỚC TRỨNG THƯỜNG
                        if PriorityTitanic then
                            local urgent = findTitanicEgg()
                            if urgent then
                                breakEgg(urgent,true)
                                task.wait(0.05)
                                continue
                            end
                        end

                        -- NORMAL EGG: HIGHEST HP FIRST
                        local egg = findEgg(zoneName)

                        if egg then
                            local hp = tonumber(egg:GetAttribute("HP")) or 0
                            setStatus("Highest HP: "..egg.Name.." ["..tostring(hp).." HP]")
                            breakEgg(egg,false)
                        else
                            if not hasCollectTarget() and not hasShardTarget() then
                                setStatus("Checking "..zoneName)
                                advanceZone()
                            end
                            task.wait(0.12)
                        end
                    else
                        setStatus("Select a Zone")
                        task.wait(0.3)
                    end
                end
            end

        elseif AutoCollect and not CollectRequested then
            if not EquipBestPending then setStatus("Searching Pets") end
        end

        task.wait(0.05)
    end
end)

