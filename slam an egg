local MoneyUnits = {
    K = 1e3,
    M = 1e6,
    B = 1e9,
    T = 1e12,
    QA = 1e15,
    QI = 1e18
}

local function parseMoney(value)
    if type(value) == "number" then return value end
    if type(value) ~= "string" then return nil end

    local txt = value:upper():gsub("%s+",""):gsub(",","")
    local numberPart,unitPart = txt:match("^([%d%.]+)([%a]*)$")

    if not numberPart then return nil end

    local number = tonumber(numberPart)
    if not number or number < 0 then return nil end

    local multiplier = unitPart == "" and 1 or MoneyUnits[unitPart]
    if not multiplier then return nil end

    return number * multiplier
end

local function updateMoneyThreshold()
    local parsed = parseMoney(MoneyThresholdText)
    if parsed then
        MoneyThresholdValue = parsed
        return true
    end
    return false
end

