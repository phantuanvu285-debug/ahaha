local function copySelected(source)
    local result = {}
    for key,value in pairs(source) do
        if value == true then result[key] = true end
    end
    return result
end

local function applySelected(target,source,options)
    for key in pairs(target) do target[key] = nil end
    if type(source) ~= "table" then return end

    for _,name in ipairs(options) do
        if source[name] == true then target[name] = true end
    end
end

local function getConfig()
    return {
        Version = 10,
        AutoBreak = AutoBreak,
        AutoCollect = AutoCollect,
        AutoEquipBest = AutoEquipBest,
        AutoCollectShard = AutoCollectShard,
        PriorityTitanic = PriorityTitanic,
        AutoLoadConfig = AutoLoadConfig,
        AutoCollectByMoney = AutoCollectByMoney,
        MoneyThresholdText = MoneyThresholdText,
        SelectedZones = copySelected(SelectedZones),
        SelectedRarities = copySelected(SelectedRarities),
        CollectRarities = copySelected(CollectRarities)
    }
end

local function saveConfig()
    if type(writefile) ~= "function" then
        warn("[Alexandria] Executor không hỗ trợ writefile")
        return false
    end

    local success,err = pcall(function()
        writefile(ConfigFile,HttpService:JSONEncode(getConfig()))
    end)

    if success then
        print("[Alexandria] Config saved:",ConfigFile)
        return true
    end

    warn("[Alexandria] Save failed:",err)
    return false
end

local function loadConfig()
    if type(isfile) ~= "function"
        or type(readfile) ~= "function" then
        warn("[Alexandria] Executor không hỗ trợ đọc file")
        return false
    end

    if not isfile(ConfigFile) then return false end

    local success,data = pcall(function()
        return HttpService:JSONDecode(readfile(ConfigFile))
    end)

    if not success or type(data) ~= "table" then
        warn("[Alexandria] Config không hợp lệ")
        return false
    end

    AutoBreak = data.AutoBreak == true
    AutoCollect = data.AutoCollect == true
    AutoEquipBest = data.AutoEquipBest == true
    AutoCollectShard = data.AutoCollectShard == true
    PriorityTitanic = data.PriorityTitanic == true
    AutoCollectByMoney = data.AutoCollectByMoney == true

    if type(data.MoneyThresholdText) == "string" then
        MoneyThresholdText = data.MoneyThresholdText
    end

    if data.AutoLoadConfig ~= nil then
        AutoLoadConfig = data.AutoLoadConfig == true
    end

    updateMoneyThreshold()

    applySelected(SelectedZones,data.SelectedZones,ZoneOptions)
    applySelected(SelectedRarities,data.SelectedRarities,RarityOptions)
    applySelected(CollectRarities,data.CollectRarities,RarityOptions)

    print("[Alexandria] Config loaded")
    return true
end

