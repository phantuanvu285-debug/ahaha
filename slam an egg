-- SAFE EGG POSITION

local function getSafeEggCFrame(egg)
    if not egg or not egg.Parent then return nil end

    local pos = egg:GetPivot().Position
    local params = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Exclude

    local exclude = {egg}
    local character = getCharacter()
    if character then table.insert(exclude,character) end
    params.FilterDescendantsInstances = exclude

    local result = workspace:Raycast(
        pos+Vector3.new(0,35,0),
        Vector3.new(0,-120,0),
        params
    )

    local targetY = result and result.Position.Y+4.5 or pos.Y+6
    local targetPosition = Vector3.new(pos.X,targetY,pos.Z)
    local root = getHRP()
    local rotation = root and root.CFrame.Rotation or CFrame.identity

    return CFrame.new(targetPosition)*rotation
end

-- BREAK EGG
-- Titanic vẫn dùng Auto Break, nhưng bỏ qua bộ lọc Rarity.

local function breakEgg(egg,isTitanic)
    if BreakBusy or not egg or not egg.Parent then return end
    if hasCollectTarget() or hasShardTarget() then return end

    if not AutoBreak then return end

    BreakBusy = true

    local initialHP = tonumber(egg:GetAttribute("HP")) or 0
    setStatus(
        isTitanic and "PRIORITY TITANIC - "..egg.Name
        or "Breaking "..egg.Name.." ["..tostring(initialHP).." HP]"
    )

    local targetCFrame = getSafeEggCFrame(egg)
    if targetCFrame and not hasCollectTarget() and not hasShardTarget() then
        safeTeleport(targetCFrame)
    end

    task.wait(0.15)
    local lastCheck = 0

    while Running
        and AutoBreak
        and egg.Parent
        and (tonumber(egg:GetAttribute("HP")) or 0) > 0 do

        if hasCollectTarget() then
            setStatus("Pet Detected - Pausing Break")
            break
        end

        if hasShardTarget() then
            setStatus("Shard Detected - Pausing Break")
            break
        end

        if isTitanic and not isTitanicEgg(egg) then
            setStatus("Titanic Target Lost")
            break
        end

        if not isGauntletsEquipped() then equipGauntlets() end
        if hasCollectTarget() or hasShardTarget() then break end

        if Player:GetAttribute("AutoSmash") ~= true then
            enableAutoSmash()
        end

        if os.clock()-lastCheck > 0.5 then
            lastCheck = os.clock()

            local root = getHRP()
            local eggPos = getEggPos(egg)

            if root and eggPos then
                local distance = (root.Position-eggPos).Magnitude
                if distance > 22 and not hasCollectTarget() and not hasShardTarget() then
                    local newCFrame = getSafeEggCFrame(egg)
                    if newCFrame then safeTeleport(newCFrame) end
                end
            end
        end

        task.wait(0.08)
    end

    BreakBusy = false

    if isTitanic then
        if not egg.Parent or (tonumber(egg:GetAttribute("HP")) or 0) <= 0 then
            setStatus("Titanic Destroyed - Resume Farm")
            print("[Alexandria] Titanic Zone11 destroyed")
        end
    else
        if not egg.Parent or (tonumber(egg:GetAttribute("HP")) or 0) <= 0 then
            print("[Alexandria] Egg destroyed:",egg.Name,"HP:",initialHP)
        end
    end

    if CollectRequested then
        setStatus("Collect Priority")
    elseif hasShardTarget() then
        setStatus("Shard Collect Priority")
    end
end

