local function multi(parent,title,y,options,selected)
    label(parent,title.." (none = any)",UDim2.new(1,-20,0,18),UDim2.fromOffset(12,y),11)

    local display = button(parent,"---                         ﹀",UDim2.new(1,-20,0,25),UDim2.fromOffset(10,y+19))
    display.TextXAlignment = Enum.TextXAlignment.Left
    display.TextTruncate = Enum.TextTruncate.AtEnd

    local holder = Instance.new("Frame")
    holder.Position = UDim2.fromOffset(10,y+47)
    holder.Size = UDim2.new(1,-20,0,0)
    holder.BackgroundColor3 = Color3.fromRGB(24,24,27)
    holder.BorderSizePixel = 0
    holder.Visible = false
    holder.ClipsDescendants = true
    holder.ZIndex = 20
    holder.Parent = parent
    corner(holder,5)
    stroke(holder)

    local scroll = Instance.new("ScrollingFrame")
    scroll.Name = "OptionsScroll"
    scroll.Size = UDim2.new(1,0,1,0)
    scroll.BackgroundTransparency = 1
    scroll.BorderSizePixel = 0
    scroll.Active = true
    scroll.ScrollingEnabled = true
    scroll.ScrollingDirection = Enum.ScrollingDirection.Y
    scroll.ElasticBehavior = Enum.ElasticBehavior.WhenScrollable
    scroll.ScrollBarThickness = 5
    scroll.ScrollBarImageColor3 = Color3.fromRGB(145,145,155)
    scroll.CanvasSize = UDim2.new(0,0,#options*29,0)
    scroll.ZIndex = 21
    scroll.Parent = holder

    local layout = Instance.new("UIListLayout")
    layout.Padding = UDim.new(0,2)
    layout.SortOrder = Enum.SortOrder.LayoutOrder
    layout.Parent = scroll

    local function refresh()
        local names = {}
        for _,name in ipairs(options) do
            if selected[name] then table.insert(names,name) end
        end

        display.Text = (#names == 0 and "---" or table.concat(names,", ")).."                         ﹀"

        for _,child in ipairs(scroll:GetChildren()) do
            if child:IsA("TextButton") then
                local name = child:GetAttribute("OptionName")
                if name then child.Text = (selected[name] and "■  " or "□  ")..name end
            end
        end
    end

    for i,name in ipairs(options) do
        local opt = Instance.new("TextButton")
        opt.Name = "Option_"..name
        opt.Size = UDim2.new(1,-8,0,27)
        opt.BackgroundColor3 = Color3.fromRGB(29,29,33)
        opt.BorderSizePixel = 0
        opt.Text = (selected[name] and "■  " or "□  ")..name
        opt.TextColor3 = Color3.fromRGB(225,225,230)
        opt.Font = Enum.Font.Gotham
        opt.TextSize = 11
        opt.TextXAlignment = Enum.TextXAlignment.Left
        opt.LayoutOrder = i
        opt.ZIndex = 22
        opt:SetAttribute("OptionName",name)
        opt.Parent = scroll
        corner(opt,4)

        opt.MouseButton1Click:Connect(function()
            selected[name] = not selected[name]
            refresh()
        end)
    end

    local opened = false
    display.MouseButton1Click:Connect(function()
        opened = not opened
        holder.Visible = opened
        holder.Size = opened and UDim2.new(1,-20,0,math.min(#options*29,200)) or UDim2.new(1,-20,0,0)
        if opened then scroll.CanvasPosition = Vector2.zero end
    end)

    refresh()
    return refresh
end

