-- COLLECT CHICKEN

local function collectChicken()
    if CollectBusy or not AutoCollect then return false end

    local target = findChicken()
    if not target then
        CollectRequested = false
        return false
    end

    CollectBusy = true
    CollectRequested = true

    local incomeText = ""
    if target.Income and target.Income > 0 then
        incomeText = " ["..string.format("%.3g",target.Income).."/s]"
    end

    setStatus("Collecting "..tostring(target.PetName).." ["..tostring(target.Rarity).."]"..incomeText)

    local collected = false

    for attempt = 1,3 do
        if not Running or not AutoCollect then break end
        if not target.Pet or not target.Pet.Parent then
            collected = true
            break
        end
        if not target.Part or not target.Part.Parent then
            collected = true
            break
        end

        local prompt = target.Part:FindFirstChild("StealPrompt")
        if not prompt or not prompt.Enabled then
            collected = true
            break
        end

        safeTeleport(target.Part.CFrame*CFrame.new(0,0,2))
        task.wait(0.15)

        if prompt.Parent and prompt.Enabled then
            pcall(function() fireproximityprompt(prompt) end)
        end

        local start = os.clock()
        repeat
            task.wait(0.1)
            if not target.Pet.Parent or not prompt.Parent or not prompt.Enabled then
                collected = true
                break
            end
        until os.clock()-start >= 1.2

        if collected then break end
    end

    if collected then
        setStatus("Pet Collected")
        safeTeleport(HomeCFrame)
        if AutoEquipBest then
            EquipBestPending = true
            LastCollectedAt = os.clock()
        end
    else
        setStatus("Retrying Pet Collect")
    end

    CollectBusy = false
    task.wait(0.1)
    CollectRequested = findChicken() ~= nil
    return collected
end

-- COLLECT SHARD

local function collectShard()
    if not AutoCollectShard or ShardBusy or CollectBusy or hasCollectTarget() then
        return false
    end

    local shard = findShard()
    if not shard or not shard.Parent then return false end

    ShardBusy = true
    local beforeCount = getShardCount()
    local previousCFrame
    local root = getHRP()
    if root then previousCFrame = root.CFrame end

    setStatus("Going To Shard")
    local increased = false

    requestArea(shard.Position)

    if shard.Parent then
        local targetPosition = shard.Position+Vector3.new(0,2,0)
        if safeTeleport(CFrame.new(targetPosition)) then
            setStatus("Collecting Shard")
            local start = os.clock()

            repeat
                task.wait(0.1)
                local currentCount = getShardCount()
                if currentCount >= beforeCount+1 then
                    increased = true
                    break
                end
                if not shard.Parent then break end
            until os.clock()-start >= 3 or not Running or not AutoCollectShard
        end
    end

    local afterCount = getShardCount()
    if afterCount >= beforeCount+1 then increased = true end

    if increased then
        setStatus("Shard Collected +"..tostring(afterCount-beforeCount))
        print("[Alexandria] Shard collected:",beforeCount,"->",afterCount)
    else
        setStatus("Shard Not Confirmed")
    end

    if previousCFrame and Running then
        task.wait(0.1)
        safeTeleport(previousCFrame)
    end

    ShardBusy = false
    return increased
end

-- ZONE HELPERS

local function getZoneFolder(zoneName)
    local root = workspace:FindFirstChild("ZoneEggs")
    return root and root:FindFirstChild(zoneName)
end

local function getZoneEggFolder(zoneName)
    local zone = getZoneFolder(zoneName)
    return zone and zone:FindFirstChild("Eggs")
end

local function getStagePosition(zoneName)
    if ZoneStage[zoneName] then return ZoneStage[zoneName] end

    local zone = getZoneFolder(zoneName)
    local slots = zone and zone:FindFirstChild("Slots")
    local hrp = getHRP()

    if slots then
        local nearest
        local nearestDistance = math.huge

        for _,slot in ipairs(slots:GetChildren()) do
            if slot:IsA("BasePart") then
                local distance = hrp and (hrp.Position-slot.Position).Magnitude or 0
                if distance < nearestDistance then
                    nearestDistance = distance
                    nearest = slot
                end
            end
        end

        if nearest then return nearest.Position+Vector3.new(0,4,0) end
    end

    return nil
end

local function stageZone(zoneName)
    if not AutoBreak or hasCollectTarget() or hasShardTarget() then
        return false
    end

    local eggs = getZoneEggFolder(zoneName)
    if eggs and #eggs:GetChildren() > 0 then return true end

    local now = os.clock()
    if LastStageTime[zoneName] and now-LastStageTime[zoneName] < 1.5 then
        return false
    end
    LastStageTime[zoneName] = now

    local position = getStagePosition(zoneName)
    if not position then
        setStatus("Finding Slot "..zoneName)
        return false
    end

    setStatus("Teleporting to "..zoneName)
    if hasCollectTarget() or hasShardTarget() then return false end

    if not safeTeleport(CFrame.new(position)) then
        setStatus("Teleport failed "..zoneName)
        return false
    end

    requestArea(position)
    local start = os.clock()

    repeat
        task.wait(0.15)

        if hasCollectTarget() then
            setStatus("Pet Detected - Collect Priority")
            return false
        end
        if hasShardTarget() then
            setStatus("Shard Detected - Collect Priority")
            return false
        end

        eggs = getZoneEggFolder(zoneName)
        if eggs and #eggs:GetChildren() > 0 then
            setStatus(zoneName.." Loaded")
            return true
        end
    until os.clock()-start >= 8 or not Running or not AutoBreak

    return false
end

-- EGG POSITION

local function getEggPos(egg)
    local ok,cf = pcall(function() return egg:GetPivot() end)
    if ok and cf then return cf.Position end
    local part = egg:FindFirstChildWhichIsA("BasePart",true)
    return part and part.Position
end

-- NORMAL EGG
-- NEW: PICK HIGHEST HP FIRST
-- IF HP IS EQUAL, PICK NEAREST EGG

local function findEgg(zoneName)
    if not zoneName then return nil end

    local eggsFolder = getZoneEggFolder(zoneName)
    if not eggsFolder then return nil end

    local best
    local bestHP = -math.huge
    local bestDistance = math.huge
    local hrp = getHRP()

    for _,egg in ipairs(eggsFolder:GetChildren()) do
        if egg:IsA("Model") then
            local hp = tonumber(egg:GetAttribute("HP")) or 0
            local rarity = egg:GetAttribute("Rarity") or egg:GetAttribute("Tier")
            local pos = getEggPos(egg)

            if hp > 0 and pos and isSelected(SelectedRarities,rarity) then
                local distance = hrp and (hrp.Position-pos).Magnitude or 0

                if hp > bestHP
                    or (hp == bestHP and distance < bestDistance) then

                    best = egg
                    bestHP = hp
                    bestDistance = distance
                end
            end
        end
    end

    return best
end

--========================================================
-- TITANIC DETECTION - ZONE11 ONLY
-- Detect by model name or string attributes containing "Titanic"
--========================================================

local function textContainsTitanic(value)
    if type(value) ~= "string" then return false end
    return value:lower():find("titanic",1,true) ~= nil
end

local function hasTitanicMarker(instance)
    if textContainsTitanic(instance.Name) then return true end

    for attributeName,value in pairs(instance:GetAttributes()) do
        if textContainsTitanic(attributeName) or textContainsTitanic(value) then
            return true
        end
    end

    return false
end

local function isTitanicEgg(egg)
    if not egg or not egg:IsA("Model") then return false end

    if hasTitanicMarker(egg) then return true end

    for _,descendant in ipairs(egg:GetDescendants()) do
        if hasTitanicMarker(descendant) then
            return true
        end
    end

    return false
end

local function findTitanicEgg()
    if not PriorityTitanic then return nil end

    -- CHỈ QUÉT ZONE11
    local eggsFolder = getZoneEggFolder("Zone11")
    if not eggsFolder then return nil end

    local best
    local bestDistance = math.huge
    local hrp = getHRP()

    for _,egg in ipairs(eggsFolder:GetChildren()) do
        if egg:IsA("Model") and isTitanicEgg(egg) then
            local hp = tonumber(egg:GetAttribute("HP")) or 0
            local pos = getEggPos(egg)

            if hp > 0 and pos then
                local distance = hrp and (hrp.Position-pos).Magnitude or 0
                if distance < bestDistance then
                    best = egg
                    bestDistance = distance
                end
            end
        end
    end

    return best
end

